---
import FormApi from "../components/formApi.astro";
import Layout from "../layouts/Layout.astro";
import siteData from "../assets/data.json";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface ContactAsset {
  nombre?: string;
  url?: string;
}

interface SiteData {
  CONTACTO: ContactAsset[];
}

const images = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/images/**/*.{png,jpg,jpeg,webp}",
  { eager: true },
);

const [contactAsset] = (siteData as SiteData).CONTACTO;
const contactPath = contactAsset?.url ? `../assets/images/${contactAsset.url}` : undefined;
const contactImage = contactPath ? images[contactPath]?.default : undefined;
---

<Layout title="Contacto | PATO Studio" description="Escríbenos para encargos, colaboraciones o dudas sobre piezas de PATO Studio.">
  <section class="contact-page" aria-labelledby="contact-title">
    <div class="intro">
      <p>CONTACTO</p>
      <h1 id="contact-title">Hablemos de tu pieza</h1>
      <div class="copy">
        <p>
          Escríbenos para encargos, dudas sobre piezas disponibles, colaboraciones o propuestas especiales.
        </p>
        <p>
          Leemos cada mensaje con calma y respondemos lo antes posible con el siguiente paso.
        </p>
      </div>
      {contactImage && (
        <div class="contact-image">
          <Image src={contactImage} alt={contactAsset.nombre ?? "PAULA"} width={560} height={560} loading="lazy" decoding="async" inferSize />
        </div>
      )}
    </div>

    <div class="form-panel">
      <FormApi />
    </div>
  </section>
</Layout>

<style>
  .contact-page {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(20rem, 1fr);
    gap: clamp(2.5rem, 6vw, 6rem);
    max-width: var(--container);
    margin-inline: auto;
    padding: clamp(4rem, 8vw, 7rem) clamp(1rem, 4.4vw, 4rem) clamp(6rem, 9vw, 8rem);
  }

  .intro {
    align-self: start;
  }

  .intro > p {
    margin: 0 0 1rem;
    color: var(--color-brand);
    font-family: var(--font-body);
    font-size: 1rem;
    font-weight: 700;
  }

  h1 {
    max-width: 34rem;
    margin: 0;
    color: var(--color-ink);
    font-family: var(--font-heading);
    font-size: clamp(3rem, 6.5vw, 5.75rem);
    font-weight: 200;
    line-height: 0.95;
  }

  .copy {
    display: grid;
    gap: 1rem;
    max-width: 35rem;
    margin-top: 2rem;
  }

  .copy p {
    margin: 0;
    color: #474747;
    font-family: var(--font-body);
    font-size: clamp(1rem, 1.4vw, 1.25rem);
    font-weight: 700;
    line-height: 1.25;
  }

  .contact-image {
    margin-top: clamp(2rem, 4vw, 3rem);
    overflow: hidden;
    aspect-ratio: 1;
  }

  .contact-image :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .form-panel {
    border: 1px solid var(--color-line);
    background: rgb(255 255 255 / 60%);
    padding: clamp(1.25rem, 3vw, 2rem);
  }

  @media (max-width: 52rem) {
    .contact-page {
      grid-template-columns: 1fr;
    }
  }
</style>
