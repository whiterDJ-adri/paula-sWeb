---
import Layout from "../layouts/Layout.astro";
import EditorialGallery from "../components/EditorialGallery.astro";
import HeroSection from "../components/HeroSection.astro";
import HomeImageRow from "../components/HomeImageRow.astro";
import HomeStory from "../components/HomeStory.astro";
import siteData from "../assets/data.json";
import type { ImageMetadata } from "astro";

interface JsonAsset {
	nombre?: string;
	altFoto?: string;
	urlFoto?: string;
	orden?: number;
}

interface SiteData {
	home: Record<string, JsonAsset[]>;
}

const images = import.meta.glob<{ default: ImageMetadata }>(
	"../assets/**/*.{png,jpg,jpeg,webp}",
	{ eager: true },
);

const toItems = (assets: JsonAsset[] = []) =>
	[...assets]
		.sort((a, b) => (a.orden ?? 0) - (b.orden ?? 0))
		.map((asset) => {
			const imagePath = asset.urlFoto?.replace("./", "../assets/");

			return {
				image: imagePath ? images[imagePath]?.default : undefined,
				alt: asset.altFoto ?? asset.nombre ?? "Imagen PATO Studio",
			};
		})
		.filter((item) => item.image);

const homeData = (siteData as SiteData).home;
const rowItems = toItems(homeData.carrousel);
const featureItems = toItems(homeData.theMolting).slice(0, 3);
const [heroItem, ...homeItems] = toItems(homeData.home);
---

<Layout title="PATO Studio">
  <HeroSection image={heroItem?.image} alt={heroItem?.alt} />
  <HomeImageRow items={rowItems} />
  <div class="home-sections">
    <EditorialGallery items={featureItems} />
    <EditorialGallery title="ANTERIORES" subtitle="" variant="archive" items={homeItems} />
  </div>
  <HomeStory />
</Layout>

<style>
  .home-sections {
    display: grid;
    gap: clamp(7.5rem, 10vw, 11rem);
    margin-block: clamp(4rem, 6vw, 6.5rem) clamp(7rem, 9vw, 10rem);
  }
</style>
