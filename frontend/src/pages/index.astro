---
import Layout from "../layouts/Layout.astro";
import EditorialGallery from "../components/EditorialGallery.astro";
import HeroSection from "../components/HeroSection.astro";
import HomeStory from "../components/HomeStory.astro";

import heroImage from "../assets/images/home/hero.webp";
import theMoltingOne from "../assets/images/home/the-molting/campaign-01.webp";
import theMoltingSeven from "../assets/images/home/the-molting/7.webp";
import theMoltingEight from "../assets/images/home/the-molting/8.webp";
import previousCenter from "../assets/images/anteriores/serie-01/ari-en-medio-foto.webp";
import previousLeft from "../assets/images/anteriores/serie-01/izquierda.mp4";
import previousRight from "../assets/images/anteriores/serie-01/derecha.mp4";
import previousTwoOne from "../assets/images/anteriores/serie-02/mapo-01.webp";
import previousTwoTwo from "../assets/images/anteriores/serie-02/mapo-02.webp";
import previousTwoThree from "../assets/images/anteriores/serie-02/mapo-03.webp";

const theMoltingItems = [
  { image: theMoltingOne, alt: "The Molting, modelo con anillos junto a unas uvas" },
  { image: theMoltingSeven, alt: "The Molting, dos modelos con helados y joyeria" },
  { image: theMoltingEight, alt: "The Molting, modelo con joyeria y fondo exterior" },
];
const previousItems = [
  { video: previousLeft, alt: "Anteriores, video izquierdo" },
  { image: previousCenter, alt: "Anteriores, retrato central de Ari" },
  { video: previousRight, alt: "Anteriores, video derecho" },
];
const previousTwoItems = [
  { image: previousTwoOne, alt: "Anteriores 2, editorial uno" },
  { image: previousTwoTwo, alt: "Anteriores 2, editorial dos" },
  { image: previousTwoThree, alt: "Anteriores 2, editorial tres" },
];
---

<Layout
  title="PATO Studio"
  description="PATO Studio crea piezas y productos que nadan fuera de lo obvio. Joyería editorial en series limitadas."
>
  <HeroSection image={heroImage} alt="Manos con joyeria PATO sobre fondo azul" eyebrow="" />
  <div class="home-sections">
    <EditorialGallery id="the-molting-title" title="THE MOLTING" subtitle="" items={theMoltingItems} />
    <EditorialGallery id="anteriores-primary-title" title="ANTERIORES" subtitle="" variant="archive" items={previousItems} />
    <EditorialGallery id="anteriores-secondary-title" title="ANTERIORES" subtitle="" variant="archive" items={previousTwoItems} />
  </div>
  <HomeStory />
</Layout>

<style>
  .home-sections {
    display: grid;
    gap: clamp(4.5rem, 8vw, 8rem);
    margin-block: clamp(4rem, 6vw, 6.5rem) clamp(5rem, 8vw, 8rem);
  }
</style>
