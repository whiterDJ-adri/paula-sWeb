---
import Layout from "../layouts/Layout.astro";
import EditorialGallery from "../components/EditorialGallery.astro";
import HeroSection from "../components/HeroSection.astro";
import HomeImageRow from "../components/HomeImageRow.astro";
import HomeStory from "../components/HomeStory.astro";
---

<Layout title="PATO Studio">
  <HeroSection />
  <HomeImageRow />
  <div class="home-sections">
    <EditorialGallery />
    <EditorialGallery title="ANTERIORES" subtitle="" variant="archive" />
    <EditorialGallery title="ANTERIORES" subtitle="" variant="archive" />
  </div>
  <HomeStory />
</Layout>

<style>
  .home-sections {
    display: grid;
    gap: clamp(4rem, 5vw, 4.5rem);
  }
</style>
