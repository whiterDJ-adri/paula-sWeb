---
import Layout from "../layouts/Layout.astro";
import ProductGrid from "../components/ProductGrid.astro";
import ProductModal from "../components/ProductModal.astro";
import ShopCategoryNav from "../components/ShopCategoryNav.astro";
import siteData from "../assets/data.json";
import type { ImageMetadata } from "astro";

interface JsonProduct {
	nombre?: string;
	descripcion?: string;
	precio?: number | string;
	url?: string;
	talla?: string;
	tamano?: string;
	modelo?: string;
}

interface ProductTree {
	ANILLOS: Record<string, JsonProduct[]>;
	BRAZALETES: JsonProduct[];
	COLLARES: Record<string, JsonProduct[]>;
	OTROS: Record<string, JsonProduct[]>;
}

interface SiteData {
	TIENDA: {
		PRODUCTO: ProductTree;
	};
}

const images = import.meta.glob<{ default: ImageMetadata }>(
	"../assets/images/**/*.{png,jpg,jpeg,webp}",
	{ eager: true },
);

const toProducts = (products: JsonProduct[]) =>
	products.map((product) => {
		const imagePath = product.url ? `../assets/images/${product.url}` : undefined;

		return {
			nombre: product.nombre,
			precio: product.precio,
			desc: product.descripcion,
			imagen: imagePath ? images[imagePath]?.default : undefined,
			imageAlt: product.nombre,
			talla: product.talla,
			tamano: product.tamano,
			modelo: product.modelo,
		};
	});

const products = (siteData as SiteData).TIENDA.PRODUCTO;
const sections = [
	{
		id: "anillos",
		title: "Anillos",
		products: toProducts(Object.values(products.ANILLOS).flat()),
	},
	{
		id: "brazaletes",
		title: "Brazaletes",
		products: toProducts(products.BRAZALETES),
	},
	{
		id: "collares",
		title: "Collares",
		products: toProducts(Object.values(products.COLLARES).flat()),
	},
	...Object.entries(products.OTROS).map(([title, items]) => ({
		id: title.toLowerCase(),
		title,
		products: toProducts(items),
	})),
];
---

<Layout
	title="Tienda | PATO Studio"
	description="Tienda de PATO Studio con piezas únicas, colecciones limitadas, fundas y objetos especiales.">
	<ShopCategoryNav />
	<div class="shop-page" aria-label="Tienda PATO Studio">
		{
			sections.map((section, index) => (
				<ProductGrid
					id={section.id}
					title={section.title}
					products={section.products}
					emptyMessage={`Las piezas de ${section.title.toLowerCase()} estarán disponibles próximamente.`}
					minItems={12}
					priorityCount={index === 0 ? 4 : 0}
				/>
			))
		}
	</div>
	<ProductModal />
</Layout>

<style>
	.shop-page {
		padding-bottom: 8rem;
	}
</style>
