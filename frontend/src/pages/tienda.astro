---
import Layout from "../layouts/Layout.astro";
import ProductGrid from "../components/ProductGrid.astro";
import ProductModal from "../components/ProductModal.astro";
import ShopCategoryNav from "../components/ShopCategoryNav.astro";
import shopData from "../assets/data.json";
import type { ImageMetadata } from "astro";

interface Product {
	nombre?: string;
	precio?: number | string;
	imagen?: ImageMetadata | string;
	imageAlt?: string;
	desc?: string;
	details?: string;
}

interface JsonProduct {
	nombre?: string;
	descripcion?: string;
	precio?: number | string;
	urlFoto?: string;
	altFoto?: string;
	coleccion?: string;
	categoria?: string;
	materiales?: string[];
	colores?: string[];
	piezaUnica?: boolean;
	stock?: number;
	estado?: string;
	orden?: number;
}

interface SiteData {
	tienda: Record<string, JsonProduct[]>;
}

const images = import.meta.glob<{ default: ImageMetadata }>(
	"../assets/**/*.{png,jpg,jpeg,webp}",
	{ eager: true },
);

const formatTitle = (folder: string) =>
	folder
		.replace(/([a-z])([A-Z])/g, "$1 $2")
		.replace(/[-_]/g, " ")
		.replace(/\b\w/g, (letter) => letter.toUpperCase());

const sectionTitles: Record<string, string> = {
	coleccionTheMolting: "Colección The Molting",
	blueTears: "Blue Tears",
	fundas: "Fundas",
	otros: "Otros",
};

const formatStatus = (status: string) =>
	status === "disponible" ? "Disponible" : status.charAt(0).toUpperCase() + status.slice(1);

const normalize = (value = "") =>
	value
		.toLowerCase()
		.normalize("NFD")
		.replace(/\p{Diacritic}/gu, "");

const tiendaData = (shopData as SiteData).tienda;

const sections = Object.entries(tiendaData).map(
	([folder, products]) => ({
		id: normalize(sectionTitles[folder] ?? formatTitle(folder)).replace(/\s+/g, "-"),
		title: sectionTitles[folder] ?? formatTitle(folder),
		products: [...products]
			.sort((a, b) => (a.orden ?? 0) - (b.orden ?? 0))
			.map((product) => {
				const imagePath = product.urlFoto?.replace("./", "../assets/");
				const details = [
					product.coleccion ? `Colección: ${product.coleccion}` : undefined,
					product.categoria ? `Categoría: ${product.categoria}` : undefined,
					product.materiales?.length ? `Materiales: ${product.materiales.join(", ")}` : undefined,
					product.colores?.length ? `Colores: ${product.colores.join(", ")}` : undefined,
					product.piezaUnica ? "Pieza única 1/1" : undefined,
					product.stock !== undefined ? `Stock: ${product.stock}` : undefined,
					product.estado ? `Estado: ${formatStatus(product.estado)}` : undefined,
				].filter(Boolean).join(" | ");

				return {
					nombre: product.nombre,
					precio: product.precio,
					desc: product.descripcion,
					imagen: imagePath ? images[imagePath]?.default : undefined,
					imageAlt: product.altFoto ?? product.nombre,
					details,
				};
			}),
	}),
);

---


<Layout
	title="Tienda | PATO Studio"
	description="Tienda de PATO Studio con anillos, brazaletes, collares y pendientes.">
	<ShopCategoryNav />
	<div
		class="shop-page"
		aria-label="Tienda PATO Studio">
		{
			sections.map((section) => (
				<ProductGrid
					id={section.id}
					title={section.title}
					products={section.products}
					emptyMessage={`Piezas de ${section.title.toLowerCase()} pendientes de integrar.`}
					minItems={12}
				/>
			))
		}
	</div>
	<ProductModal />
</Layout>

<style>
	.shop-page {
		padding-bottom: 8rem;
	}
</style>
