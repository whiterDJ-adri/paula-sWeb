---
import Layout from "../layouts/Layout.astro";
import ProductGrid from "../components/ProductGrid.astro";
import ProductModal from "../components/ProductModal.astro";
import shopData from "../assets/data.json";
import type { ImageMetadata } from "astro";

interface JsonProduct {
	nombre?: string;
	descripcion?: string;
	precio?: number | string;
	urlFoto?: string;
	altFoto?: string;
	coleccion?: string;
	categoria?: string;
	piezaUnica?: boolean;
	stock?: number;
	estado?: string;
	orden?: number;
}

interface SiteData {
	tienda: {
		otros?: JsonProduct[];
	};
}

const images = import.meta.glob<{ default: ImageMetadata }>(
	"../assets/**/*.{png,jpg,jpeg,webp}",
	{ eager: true },
);

const formatStatus = (status: string) =>
	status === "disponible" ? "Disponible" : status.charAt(0).toUpperCase() + status.slice(1);

const products = [...((shopData as SiteData).tienda.otros ?? [])]
	.sort((a, b) => (a.orden ?? 0) - (b.orden ?? 0))
	.map((product) => {
		const imagePath = product.urlFoto?.replace("./", "../assets/");
		const details = [
			product.coleccion ? `Colección: ${product.coleccion}` : undefined,
			product.categoria ? `Categoría: ${product.categoria}` : undefined,
			product.piezaUnica ? "Pieza única 1/1" : undefined,
			product.stock !== undefined ? `Stock: ${product.stock}` : undefined,
			product.estado ? `Estado: ${formatStatus(product.estado)}` : undefined,
		].filter(Boolean).join(" | ");

		return {
			nombre: product.nombre,
			precio: product.precio,
			desc: product.descripcion,
			imagen: imagePath ? images[imagePath]?.default : undefined,
			imageAlt: product.altFoto ?? product.nombre,
			details,
		};
	});
---

<Layout
	title="PATO Especiales | PATO Studio"
	description="Objetos y piezas especiales de PATO Studio, creados en series pequeñas y unidades singulares.">
	<section class="specials-intro" aria-labelledby="specials-title">
		<p>OBJETOS ESPECIALES</p>
		<h1 id="specials-title">PATO Especiales</h1>
		<div class="copy">
			<p>
				Piezas fuera de colección: bandejas, ceniceros y objetos intervenidos
				que nacen del mismo universo del estudio.
			</p>
			<p>
				Cada objeto está disponible como pieza única o en series muy limitadas.
			</p>
		</div>
	</section>

	<div class="specials-products">
		<ProductGrid
			id="objetos-especiales"
			title="Disponibles"
			products={products}
			emptyMessage="Próximamente habrá nuevas piezas especiales disponibles."
			minItems={0}
			priorityCount={3}
		/>
	</div>
	<ProductModal />
</Layout>

<style>
	.specials-intro {
		max-width: var(--container);
		margin-inline: auto;
		padding: clamp(4rem, 8vw, 7rem) clamp(1rem, 4.4vw, 4rem) 0;
	}

	.specials-intro > p {
		margin: 0 0 1rem;
		color: var(--color-brand);
		font-family: var(--font-body);
		font-size: 1rem;
		font-weight: 700;
	}

	h1 {
		max-width: 46rem;
		margin: 0;
		color: var(--color-ink);
		font-family: var(--font-heading);
		font-size: clamp(3rem, 7vw, 6rem);
		font-weight: 200;
		line-height: 0.95;
	}

	.copy {
		display: grid;
		gap: 1rem;
		max-width: 37rem;
		margin-top: 2rem;
	}

	.copy p {
		margin: 0;
		color: #474747;
		font-family: var(--font-body);
		font-size: clamp(1rem, 1.4vw, 1.25rem);
		line-height: 1.4;
	}

	.specials-products {
		padding-bottom: clamp(5rem, 9vw, 8rem);
	}
</style>
