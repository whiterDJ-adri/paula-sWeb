---
import Layout from "../layouts/Layout.astro";
import EditorialGallery from "../components/EditorialGallery.astro";
import siteData from "../assets/data.json";
import type { ImageMetadata } from "astro";

interface JsonAsset {
	nombre?: string;
	url?: string;
}

interface SiteData {
	"PATO ESPECIALES": {
		"LUNA KI MICRO": Record<string, JsonAsset[]>;
	};
}

const images = import.meta.glob<{ default: ImageMetadata }>(
	"../assets/images/**/*.{png,jpg,jpeg,webp}",
	{ eager: true },
);

const toItems = (assets: JsonAsset[] = []) =>
	assets
		.map((asset) => {
			const imagePath = asset.url ? `../assets/images/${asset.url}` : undefined;

			return {
				image: imagePath ? images[imagePath]?.default : undefined,
				alt: asset.nombre ?? "Proyecto PATO Especiales",
			};
		})
		.filter((item) => item.image);

const specialProjects = (siteData as SiteData)["PATO ESPECIALES"]["LUNA KI MICRO"];
---

<Layout
	title="PATO Especiales | PATO Studio"
	description="Objetos y piezas especiales de PATO Studio, creados en series pequeñas y unidades singulares.">
	<section class="specials-intro" aria-labelledby="specials-title">
		<p>OBJETOS ESPECIALES</p>
		<h1 id="specials-title">PATO Especiales</h1>
		<div class="copy">
			<p>
				Proyectos fuera de colección que nacen del mismo universo del estudio.
			</p>
			<p>
				Luna Ki Micro reúne piezas e imágenes desarrolladas para proyectos y feria.
			</p>
		</div>
	</section>

	<div class="specials-projects">
		<EditorialGallery title="LUNA KI MICRO" subtitle="PROYECTO 1" items={toItems(specialProjects["PROYECTO 1"])} />
		<EditorialGallery title="LUNA KI MICRO" subtitle="PROYECTO 2" items={toItems(specialProjects["PROYECTO 2"])} />
		<EditorialGallery title="LUNA KI MICRO" subtitle="FERIA LQFB" items={toItems(specialProjects["FERIA LQFB"])} />
	</div>
</Layout>

<style>
	.specials-intro {
		max-width: var(--container);
		margin-inline: auto;
		padding: clamp(4rem, 8vw, 7rem) clamp(1rem, 4.4vw, 4rem) 0;
	}

	.specials-intro > p {
		margin: 0 0 1rem;
		color: var(--color-brand);
		font-family: var(--font-body);
		font-size: 1rem;
		font-weight: 700;
	}

	h1 {
		max-width: 46rem;
		margin: 0;
		color: var(--color-ink);
		font-family: var(--font-heading);
		font-size: clamp(3rem, 7vw, 6rem);
		font-weight: 200;
		line-height: 0.95;
	}

	.copy {
		display: grid;
		gap: 1rem;
		max-width: 37rem;
		margin-top: 2rem;
	}

	.copy p {
		margin: 0;
		color: #474747;
		font-family: var(--font-body);
		font-size: clamp(1rem, 1.4vw, 1.25rem);
		line-height: 1.4;
	}

	.specials-projects {
		display: grid;
		gap: clamp(5rem, 8vw, 8rem);
		padding: clamp(4rem, 7vw, 6rem) 0 clamp(6rem, 10vw, 10rem);
	}
</style>
