---
import "../style/globals.css";
import Navbar from "../components/navbar.astro";

interface Props {
  title?: string;
}

const { title = 'PaulasWeb' } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <Navbar />
    <!-- Hero: ocupa todo el ancho y alto de la pantalla -->
    <div class="w-full h-50 bg-[url('/fondo.webp')] bg-cover bg-center bg-no-repeat"></div>
    <main>
      <slot />
    </main>
  </body>
</html>

