---
// ProductModal: ventana emergente con el detalle del producto.
// Se activa desde card.astro al hacer click.
---

<!-- Overlay del modal, oculto por defecto -->
<div id="product-modal" class="modal-overlay" aria-hidden="true">
  <div class="modal-box">
    <button class="modal-close" id="modal-close-btn" aria-label="Cerrar">✕</button>
    <div class="modal-inner">
      <div class="modal-image">
        <img id="modal-img" src="" alt="" />
      </div>
      <div class="modal-info">
        <h2 id="modal-title"></h2>
        <p id="modal-price" class="modal-price"></p>
        <p id="modal-desc" class="modal-desc"></p>
      </div>
    </div>
  </div>
</div>

<style>
  .modal-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.5);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 1000;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.25s ease;
  }

  .modal-overlay.open {
    opacity: 1;
    pointer-events: all;
  }

  .modal-box {
    background: #fff;
    max-width: 800px;
    width: 90%;
    max-height: 90vh;
    overflow-y: auto;
    position: relative;
    transform: translateY(20px);
    transition: transform 0.25s ease;
  }

  .modal-overlay.open .modal-box {
    transform: translateY(0);
  }

  .modal-close {
    position: absolute;
    top: 1rem;
    right: 1rem;
    background: none;
    border: none;
    font-size: 1.25rem;
    cursor: pointer;
    color: #111;
    z-index: 10;
    line-height: 1;
  }

  .modal-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
  }

  .modal-image {
    aspect-ratio: 3 / 4;
    overflow: hidden;
    background: #f0f0f0;
  }

  .modal-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .modal-info {
    padding: 2rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  #modal-title {
    font-size: 1rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin: 0;
    color: #111;
  }

  .modal-price {
    font-size: 1.1rem;
    font-weight: 500;
    color: #111;
    margin: 0;
  }

  .modal-desc {
    font-size: 0.875rem;
    color: #555;
    line-height: 1.6;
    margin: 0;
  }

  @media (max-width: 600px) {
    .modal-inner {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const overlay = document.getElementById('product-modal')!;
  const closeBtn = document.getElementById('modal-close-btn')!;

  // Cerrar al pulsar el botón o fuera del modal
  closeBtn.addEventListener('click', closeModal);
  overlay.addEventListener('click', (e) => {
    if (e.target === overlay) closeModal();
  });

  // Cerrar con Escape
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeModal();
  });

  function closeModal() {
    overlay.classList.remove('open');
    overlay.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
  }

  // Escucha el evento personalizado lanzado desde las cards
  document.addEventListener('open-product-modal', (e: Event) => {
    const { title, price, image, imageAlt, desc } = (e as CustomEvent).detail;

    (document.getElementById('modal-img') as HTMLImageElement).src = image ?? '';
    (document.getElementById('modal-img') as HTMLImageElement).alt = imageAlt ?? '';
    (document.getElementById('modal-title') as HTMLElement).textContent = title ?? '';
    (document.getElementById('modal-price') as HTMLElement).textContent = price ?? '';
    (document.getElementById('modal-desc') as HTMLElement).textContent = desc ?? '';

    overlay.classList.add('open');
    overlay.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
  });
</script>
