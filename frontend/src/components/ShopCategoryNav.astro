---
interface CategoryLink {
  href: string;
  label: string;
}

interface Props {
  topLinks?: CategoryLink[];
  primaryLinks?: CategoryLink[];
  secondaryLinks?: CategoryLink[];
}

const {
  topLinks = [
    { href: "#anillos", label: "Accesorios" },
    { href: "#bandejas", label: "Otros" },
  ],
  primaryLinks = [
    { href: "#anillos", label: "Anillos" },
    { href: "#collares", label: "Collares" },
    { href: "#brazaletes", label: "Brazaletes" },
    { href: "#anillos", label: "Pendientes" },
  ],
  secondaryLinks = [
    { href: "#fundas", label: "Fundas" },
    { href: "#ceniceros", label: "Ceniceros" },
    { href: "#bandejas", label: "Bandejas" },
  ],
} = Astro.props;
---

<nav class="shop-nav" aria-label="Categorías de tienda">
  <div class="shop-nav__inner">
    <ul class="shop-nav__top">
      {topLinks.map((link) => (
        <li>
          <a href={link.href}>{link.label}</a>
        </li>
      ))}
    </ul>

    <div class="shop-nav__bottom">
      <ul class="shop-nav__primary">
        {primaryLinks.map((link) => (
          <li>
            <a href={link.href}>{link.label}</a>
          </li>
        ))}
      </ul>

      <span class="shop-nav__divider" aria-hidden="true"></span>

      <ul class="shop-nav__secondary">
        {secondaryLinks.map((link) => (
          <li>
            <a href={link.href}>{link.label}</a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</nav>

<style>
  .shop-nav {
    position: sticky;
    top: var(--header-height);
    z-index: 19;
    display: flex;
    align-items: center;
    justify-content: center;
    border-block: 1px solid var(--color-line);
    background: var(--color-canvas);
    padding-block: clamp(0.375rem, 1vw, 0.625rem);
  }

  .shop-nav__inner {
    display: grid;
    width: min(49.3vw, 44.375rem);
    min-width: 44.375rem;
    gap: 0.375rem;
  }

  ul {
    display: flex;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .shop-nav__top {
    gap: 1.6875rem;
    min-height: 1.75rem;
    align-items: center;
  }

  .shop-nav__top li:first-child {
    width: 27.3125rem;
  }

  .shop-nav__bottom {
    display: flex;
    min-height: 1.75rem;
    align-items: center;
    padding-bottom: 0.0625rem;
  }

  .shop-nav__primary {
    gap: 0.75rem;
    width: 24.9375rem;
  }

  .shop-nav__secondary {
    gap: 0.6875rem;
    padding-inline: 0.5625rem;
  }

  .shop-nav__divider {
    width: 1px;
    height: 1.5rem;
    margin-inline: 0.625rem 1.125rem;
    background: var(--color-line);
  }

  a {
    display: inline-flex;
    min-height: 1.75rem;
    align-items: center;
    color: var(--color-ink);
    font-family: var(--font-heading);
    font-size: 1.25rem;
    font-weight: 200;
    line-height: 1.4;
    text-decoration: none;
    transition: color var(--transition-ui);
  }

  .shop-nav__bottom a {
    font-style: italic;
  }

  a:hover,
  a:focus-visible {
    color: var(--color-brand);
  }

  a:focus-visible {
    border-radius: 999px;
    outline: none;
    box-shadow: var(--shadow-focus);
  }

  @media (max-width: 52rem) {
    .shop-nav {
      top: 0;
      min-height: auto;
      justify-content: flex-start;
      overflow-x: auto;
      padding-block: 0.375rem;
      padding-inline: 1rem;
    }

    .shop-nav__inner {
      min-width: 44.375rem;
      width: 44.375rem;
    }

  }
</style>
