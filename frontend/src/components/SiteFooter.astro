---
interface FooterLink {
  href: string;
  label: string;
}

interface Props {
  links?: FooterLink[];
}

const {
  links = [
    { href: "/", label: "INICIO" },
    { href: "/#servicios", label: "SERVICIOS" },
    { href: "/#nosotros", label: "NOSOTROS" },
    { href: "/contacto", label: "CONTACTO" },
    { href: "/privacidad", label: "POLÍTICAS DE PRIVACIDAD" },
  ],
} = Astro.props;
---

<footer class="site-footer">
  <nav aria-label="Navegación de pie de página">
    <ul>
      {links.map((link) => (
        <li>
          <a href={link.href}>{link.label}</a>
        </li>
      ))}
    </ul>
  </nav>
</footer>

<style>
  .site-footer {
    display: flex;
    min-height: 5.8125rem;
    align-items: center;
    background: var(--color-brand);
    padding: 1.25rem clamp(1.25rem, 7vw, 6.6875rem);
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(1rem, 9vw, 9.875rem);
    align-items: center;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  a {
    color: var(--color-cream);
    font-family: var(--font-heading);
    font-size: 1rem;
    font-weight: 700;
    text-decoration: none;
    transition: color var(--transition-ui);
  }

  a:hover,
  a:focus-visible {
    color: var(--color-canvas);
  }

  a:focus-visible {
    border-radius: 999px;
    outline: none;
    box-shadow: 0 0 0 3px rgb(247 255 228 / 35%);
  }
</style>
