---
interface Props {
  count?: number;
}

const {
  count = 4,
} = Astro.props;
---

<section class="product-strip" aria-label="Tira visual de producto pendiente de integrar">
  <div class="track">
    {Array.from({ length: count }).map((_, index) => (
      <div class:list={["product-slot", index === 0 && "product-slot--featured"]}></div>
    ))}
  </div>
</section>

<style>
  .product-strip {
    width: 100%;
    overflow: hidden;
    padding-top: 0;
    background: var(--color-canvas);
  }

  .track {
    display: flex;
    align-items: center;
    gap: clamp(1.5rem, 3.5vw, 3.125rem);
    width: min(99.5vw, 89.5625rem);
    height: clamp(18rem, 35.5vw, 31.9375rem);
    margin-inline: auto;
  }

  .product-slot {
    flex: 0 0 clamp(12rem, 22.6vw, 20.375rem);
    height: clamp(16.5rem, 30.2vw, 27.1875rem);
    background:
      radial-gradient(circle at 50% 38%, rgb(230 85 126 / 16%), transparent 32%),
      linear-gradient(135deg, transparent calc(50% - 1px), rgb(0 0 0 / 18%) 50%, transparent calc(50% + 1px)),
      var(--color-cream);
    border: 1px solid rgb(0 0 0 / 10%);
  }

  .product-slot--featured {
    flex-basis: clamp(13rem, 26.7vw, 24rem);
    height: clamp(18rem, 35.5vw, 31.9375rem);
    margin-left: -2.75rem;
  }

  @media (max-width: 47.99rem) {
    .track {
      overflow-x: auto;
      height: auto;
      padding: 2rem 1rem;
      scroll-snap-type: x mandatory;
    }

    .product-slot,
    .product-slot--featured {
      flex: 0 0 70vw;
      height: 22rem;
      margin-left: 0;
      scroll-snap-align: start;
    }
  }
</style>
