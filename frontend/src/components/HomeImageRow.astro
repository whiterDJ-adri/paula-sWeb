---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface RowItem {
  image?: ImageMetadata | string;
  alt: string;
}

interface Props {
  items?: RowItem[];
  count?: number;
}

const { items = [], count = 4 } = Astro.props;
const rowItems = items.length > 0
  ? items
  : Array.from({ length: count }, (_, index) => ({ alt: `Imagen home ${index + 1}` }));
---

<section class="image-row" aria-label="Fila de imágenes de producto">
  <div class="image-row__track">
    {rowItems.map((item, index) => (
      <div class:list={["image-row__slot", index === 0 && "image-row__slot--lead"]}>
        {item.image ? (
          <Image src={item.image} alt={item.alt} width={326} height={435} loading="lazy" decoding="async" inferSize />
        ) : null}
      </div>
    ))}
  </div>
</section>

<style>
  .image-row {
    overflow: hidden;
    background: var(--color-canvas);
    padding-top: clamp(2rem, 4vw, 4rem);
  }

  .image-row__track {
    display: flex;
    align-items: center;
    gap: clamp(2.5rem, 5vw, 5.5rem);
    width: min(99.6vw, 89.5625rem);
    height: clamp(16.5rem, 30.2vw, 27.1875rem);
    margin: 0 auto;
  }

  .image-row__slot {
    flex: 0 0 clamp(12rem, 22.6vw, 20.375rem);
    height: clamp(16.5rem, 30.2vw, 27.1875rem);
    background:
      radial-gradient(circle at 50% 42%, rgb(230 85 126 / 16%), transparent 32%),
      linear-gradient(135deg, transparent calc(50% - 1px), rgb(0 0 0 / 18%) 50%, transparent calc(50% + 1px)),
      linear-gradient(45deg, transparent calc(50% - 1px), rgb(0 0 0 / 18%) 50%, transparent calc(50% + 1px)),
      var(--color-cream);
    border: 1px solid rgb(0 0 0 / 12%);
    overflow: hidden;
  }

  .image-row__slot :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .image-row__slot--lead {
    flex-basis: clamp(12rem, 22.6vw, 20.375rem);
    height: clamp(16.5rem, 30.2vw, 27.1875rem);
    margin-left: 0;
  }

  @media (max-width: 47.99rem) {
    .image-row__track {
      overflow-x: auto;
      height: auto;
      margin-top: 0;
      gap: 1.5rem;
      padding: 2rem 1rem 2.75rem;
      scroll-snap-type: x mandatory;
    }

    .image-row__slot,
    .image-row__slot--lead {
      flex: 0 0 70vw;
      height: 22rem;
      margin-left: 0;
      scroll-snap-align: start;
    }
  }
</style>
