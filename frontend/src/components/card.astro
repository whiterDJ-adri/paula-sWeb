---
interface Props {
  title: string;
  price?: number | string;
  image?: string;
  imageAlt?: string;
  desc?: string;
}

const {
  title,
  price,
  image,
  imageAlt = '',
  desc = '',
} = Astro.props;
---

<article
  class="group flex flex-col w-full cursor-pointer"
  data-title={title}
  data-price={price ?? ''}
  data-image={image ?? ''}
  data-image-alt={imageAlt}
  data-desc={desc}
  role="button"
  tabindex="0"
>
  {image && (
    <div class="w-full aspect-3/4 overflow-hidden bg-[#f0f0f0]">
      <img src={image} alt={imageAlt} loading="lazy" class="w-full h-full object-cover transition-transform duration-500 ease-in-out group-hover:scale-105" />
    </div>
  )}
  <div class="pt-3 flex flex-col gap-1">
    <p class="m-0 text-xs font-bold uppercase tracking-wider text-neutral-900">{title}</p>
    {price && <p class="m-0 text-sm text-neutral-900 font-normal">{price}</p>}
  </div>
</article>

<script>
  document.querySelectorAll('article[data-title]').forEach((card) => {
    const open = () => {
      card.dispatchEvent(new CustomEvent('open-product-modal', {
        bubbles: true,
        detail: {
          title: card.getAttribute('data-title'),
          price: card.getAttribute('data-price'),
          image: card.getAttribute('data-image'),
          imageAlt: card.getAttribute('data-image-alt'),
          desc: card.getAttribute('data-desc'),
        }
      }));
    };
    card.addEventListener('click', open);
    card.addEventListener('keydown', (e) => {
      if ((e as KeyboardEvent).key === 'Enter') open();
    });
  });
</script>
