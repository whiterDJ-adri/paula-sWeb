---
import logoUrl from "../assets/branding/logo-pato.svg";

interface NavLink {
  href: string;
  label: string;
}

interface Props {
  links?: NavLink[];
}

const {
  links = [
    { href: "/tienda", label: "Tienda" },
    { href: "/pato-especiales", label: "Pato Especiales" },
    { href: "/contacto", label: "Contacto" },
  ],
} = Astro.props;

const basePath = import.meta.env.BASE_URL.replace(/\/$/, "");
const withBase = (href: string) => {
  if (href.startsWith("#") || href.startsWith("http")) return href;
  return `${basePath}${href}`;
};
const normalizePath = (href: string) => href.split("#")[0];
const currentPath = basePath && Astro.url.pathname.startsWith(basePath)
  ? Astro.url.pathname.slice(basePath.length) || "/"
  : Astro.url.pathname;
const isActive = (href: string) => {
  const path = normalizePath(href);
  return path === "/" ? currentPath === "/" : currentPath.startsWith(path);
};
---

<header class="site-header">
  <a class="brand" href={withBase("/")} aria-label="PATO, ir al inicio">
    <img src={logoUrl.src} alt="PATO" width="176" height="125" decoding="async" />
  </a>

  <nav class="nav" aria-label="Navegación principal">
    <ul>
      {links.map((link) => (
        <li>
          <a href={withBase(link.href)} aria-current={isActive(link.href) ? "page" : undefined}>
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    display: grid;
    grid-template-columns: clamp(8rem, 13vw, 11rem) 1fr clamp(8rem, 13vw, 11rem);
    min-height: var(--header-height);
    align-items: center;
    border-bottom: 1px solid var(--color-brand);
    background: rgb(255 255 255 / 92%);
    padding: 0.625rem clamp(1.25rem, 4.5vw, 4rem);
    backdrop-filter: blur(14px);
  }

  .brand {
    display: block;
    width: clamp(5rem, 8vw, 7.5rem);
    color: var(--color-ink);
    text-decoration: none;
  }

  .brand img {
    display: block;
    width: 100%;
    height: auto;
  }

  .nav {
    grid-column: 2;
  }

  .nav ul {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: clamp(1rem, 5.8vw, 5.25rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav a {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    color: var(--color-ink);
    font-family: var(--font-body);
    font-size: clamp(1rem, 1.65vw, 1.5rem);
    text-decoration: none;
    transition: color var(--transition-ui), transform var(--transition-ui);
  }

  .nav a:hover,
  .nav a[aria-current="page"] {
    color: var(--color-brand);
  }

  .nav a:focus-visible {
    border-radius: 999px;
    outline: none;
    box-shadow: var(--shadow-focus);
  }

  @media (max-width: 47.99rem) {
    .site-header {
      position: relative;
      grid-template-columns: 1fr;
      gap: 0.75rem;
      padding: 0.75rem 1rem 1rem;
    }

    .brand {
      width: 7.5rem;
    }

    .nav {
      grid-column: 1;
    }

    .nav ul {
      justify-content: center;
      gap: 0.25rem 1rem;
    }

    .nav a {
      min-height: 2rem;
      font-size: 0.95rem;
    }
  }
</style>
