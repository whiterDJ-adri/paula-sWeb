---
const links = [
  { href: "/", label: "Home" },
  { href: "/#tienda", label: "Tienda" },
  { href: "/#productos-especiales", label: "Productos especiales" },
  { href: "/#contacto", label: "Contacto" },
  { href: "/#sobre-pato", label: "Sobre PATO" },
];

const isActive = (href: string) => {
  if (href === "/") return Astro.url.pathname === "/";
  return Astro.url.pathname === href;
};
---

<nav class="border-b border-black/5 bg-white px-5 py-4 md:px-8 lg:px-16">
  <div class="mx-auto flex max-w-[1440px] flex-col gap-6 lg:flex-row lg:items-center lg:justify-between">
    <a
      href="/"
      aria-label="Ir al inicio"
      class="relative block h-[92px] w-[86px] shrink-0 text-black no-underline sm:h-[108px] sm:w-[98px]"
    >
      <span
        class="absolute left-0 top-0 font-[var(--font-logo)] text-[3.1rem] leading-none tracking-[-0.08em] sm:text-[3.8rem]"
      >
        P
      </span>
      <span
        class="absolute left-[1.65rem] top-[-0.15rem] rotate-[8deg] font-[var(--font-logo)] text-[3.2rem] leading-none tracking-[-0.08em] sm:left-[1.95rem] sm:text-[3.9rem]"
      >
        A
      </span>
      <span
        class="absolute left-[0.4rem] top-[2.4rem] rotate-[-10deg] font-[var(--font-logo)] text-[3.15rem] leading-none tracking-[-0.09em] sm:left-[0.45rem] sm:top-[2.8rem] sm:text-[3.85rem]"
      >
        T
      </span>
      <span
        class="absolute left-[1.9rem] top-[2.15rem] rotate-[3deg] font-[var(--font-logo)] text-[3.2rem] leading-none tracking-[-0.09em] sm:left-[2.2rem] sm:top-[2.6rem] sm:text-[3.9rem]"
      >
        O
      </span>
      <svg
        viewBox="0 0 38 38"
        aria-hidden="true"
        class="absolute bottom-1 left-0 h-7 w-7 -rotate-[18deg] sm:h-8 sm:w-8"
      >
        <path
          d="M19 2.5l3.9 10.2 10.9-4.1-5.3 10.3 9.8 4.6-11 1.3 1.7 10.9-8.9-6.6-7.8 7.9 2-10.9L3 23.5l9.9-4.3L8.2 8.8l10.4 4.4L19 2.5z"
          fill="none"
          stroke="currentColor"
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="1.8"
        />
      </svg>
    </a>

    <div class="flex flex-1 flex-col items-start gap-5 lg:flex-row lg:items-center lg:justify-center lg:gap-8">
      <ul
        class="m-0 flex list-none flex-wrap items-center gap-x-3 gap-y-2 p-0 md:gap-x-5 lg:gap-x-6 xl:gap-x-8"
      >
        {links.map((link) => (
          <li>
            <a
              href={link.href}
              class:list={[
                "rounded-full px-3 py-2 font-[var(--font-nav)] text-[1.15rem] leading-none tracking-[-0.02em] text-black no-underline transition-colors duration-200 hover:text-primary md:text-[1.35rem]",
                isActive(link.href) && "text-primary",
              ]}
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>

      <div class="flex items-center gap-3 self-end lg:self-auto">
        <a
          href="/login"
          aria-label="Favoritos"
          class="rounded-full p-2 text-black transition-colors duration-200 hover:text-primary"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true" class="h-5 w-5">
            <path
              d="M12 20.7c-4.9-3-8-5.9-8-10.1C4 7.5 6.4 5 9.4 5c1.3 0 2.5.5 3.4 1.5C13.7 5.5 14.9 5 16.2 5 19.2 5 21.6 7.5 21.6 10.6c0 4.2-3.1 7.1-8 10.1l-.8.5-.8-.5Z"
              fill="none"
              stroke="currentColor"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="1.5"
            />
            <circle cx="15.9" cy="8.9" r="0.9" fill="currentColor" />
          </svg>
        </a>
        <a
          href="/login"
          aria-label="Lista de deseos"
          class="rounded-full p-2 text-black transition-colors duration-200 hover:text-primary"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true" class="h-5 w-5">
            <path
              d="M12 20.7c-4.9-3-8-5.9-8-10.1C4 7.5 6.4 5 9.4 5c1.3 0 2.5.5 3.4 1.5C13.7 5.5 14.9 5 16.2 5 19.2 5 21.6 7.5 21.6 10.6c0 4.2-3.1 7.1-8 10.1l-.8.5-.8-.5Z"
              fill="none"
              stroke="currentColor"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="1.5"
            />
            <circle cx="15.9" cy="8.9" r="0.9" fill="currentColor" />
          </svg>
        </a>
      </div>
    </div>
  </div>
</nav>
